// FormCraft Plugin API v1 (ADR 0003). Plugins are WebAssembly components (wasm32-wasip2) built
// against this world. JSON travels as strings and is validated by the host.
package formcraft:plugin@1.0.0;

interface types {
    type json = string;

    record vec3 { x: f64, y: f64, z: f64 }
    record point2 { x: f64, y: f64 }

    /// A sketch plane: origin, X direction and normal (Y = normal × X).
    record plane { origin: vec3, x-dir: vec3, normal: vec3 }

    /// A closed polygon on a plane (counter-clockwise for outer loops); arcs are sampled by the
    /// plugin into points.
    type polygon = list<point2>;

    record mass-props { volume: f64, area: f64, bbox-min: vec3, bbox-max: vec3 }

    /// Toolbar placement, e.g. tab "Solid", group "Create".
    record placement { tab: string, group: string, pinned: bool }

    record command-spec {
        /// Must start with the plugin id: `gear.something`.
        id: string,
        label: string,
        description: string,
        /// JSON schema of the parameters (drives the dialog and the AI prompt).
        params-schema: json,
        placement: option<placement>,
        shortcut: option<string>,
        /// Offer the command to the AI assistant and MCP.
        ai: bool,
    }

    /// A custom feature: the host registers the command `<plugin>.<kind>`; running it adds the
    /// feature to the timeline, and every rebuild calls the plugin's `regenerate`.
    record feature-spec {
        kind: string,
        label: string,
        description: string,
        params-schema: json,
        placement: option<placement>,
        ai: bool,
    }
}

/// Geometry for custom features. Solids are host resources; every operation is validated by
/// the kernel (bad geometry is an `err`, never a crash).
interface geometry {
    use types.{vec3, plane, polygon, mass-props};

    resource solid {
        mass-props: func() -> result<mass-props, string>;
        /// Translate by `offset`, then rotate by `angle-deg` about `axis` through `origin`.
        transformed: func(offset: vec3, origin: vec3, axis: vec3, angle-deg: f64) -> result<solid, string>;
        fuse: func(other: borrow<solid>) -> result<solid, string>;
        cut: func(tool: borrow<solid>) -> result<solid, string>;
        common: func(other: borrow<solid>) -> result<solid, string>;
    }

    make-box: func(corner: vec3, size: vec3) -> result<solid, string>;
    make-cylinder: func(base: vec3, axis: vec3, radius: f64, height: f64) -> result<solid, string>;
    /// Extrude polygons (first = outer, rest = holes) on `p` by `distance` along the normal.
    extrude: func(p: plane, outer: polygon, holes: list<polygon>, distance: f64) -> result<solid, string>;
}

/// What the plugin may call. Model changes go through commands, like the UI, AI and MCP.
interface host {
    use types.{json};

    /// Run a registered command (built-in or another plugin's): `params` is a JSON object.
    execute: func(command: string, params: json) -> result<json, string>;
    /// `model.inspect` as JSON.
    inspect: func() -> json;
    /// 0 trace, 1 debug, 2 info, 3 warn, 4 error. Goes to the plugin log.
    log: func(level: u8, message: string);
    /// Files, only inside folders granted in the manifest.
    read-file: func(path: string) -> result<list<u8>, string>;
    write-file: func(path: string, data: list<u8>) -> result<_, string>;
}

world plugin {
    use types.{json, command-spec, feature-spec};
    use geometry.{solid};

    import host;
    import geometry;

    /// Called once after loading: the commands and features to register.
    export init: func() -> result<tuple<list<command-spec>, list<feature-spec>>, string>;
    /// A registered command was invoked (UI, shortcut, S-box, AI, MCP, CLI or a script).
    export run-command: func(id: string, params: json) -> result<json, string>;
    /// Build a custom feature from its parameters (expressions already evaluated). Must be
    /// deterministic: it runs on every rebuild.
    export regenerate: func(kind: string, params: json) -> result<solid, string>;
}
